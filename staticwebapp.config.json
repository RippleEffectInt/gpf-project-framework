{
  "platform": {
    "apiRuntime": "node:20"
  },
  "routes": [
    {
      "route": "/api/projects",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/projects/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/projects",
      "rewrite": "/index.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/design/*",
      "rewrite": "/index.html",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "rewrite": "/index.html"
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api",
      "/api/*",
      "/*.{css,js,json,png,jpg,jpeg,gif,svg,ico,woff,woff2}"
    ]
  }
}
